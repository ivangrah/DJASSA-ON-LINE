{
  "expo": {
    "name": "Djassa Online",
    "slug": "djassa-online",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "djassa",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ED0F02",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.djassaonline.app"
    },
    "android": {
      "package": "ci.djassaonline.app",
      "adaptiveIcon": {
        "backgroundColor": "#ED0F02",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Djassa Online",
      "shortName": "Djassa",
      "themeColor": "#ED0F02",
      "backgroundColor": "#ED0F02"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ED0F02"
    }
  }
}