APP_NAME="Djassa Auth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8897

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=djassa_auth_db
DB_USERNAME=postgres
DB_PASSWORD=djassa_dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
OAUTH_CONNECT_TIMEOUT=3
OAUTH_TIMEOUT=8

DJASSA_INTERNAL_API_URL=http://api-gateway:8081/internal
DJASSA_INTERNAL_SIGNING_KEY=dev-signing-key
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EVENTS_STREAM=djassa.events
CACHE_STORE=array
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
