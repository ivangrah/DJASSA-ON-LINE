{
  "name": "djassa/notification-chat-service",
  "description": "Messagerie temps r\u00e9el et notifications Brevo \u2014 Djassa Online",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.31"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "audit": {
      "block-insecure": false
    }
  }
}