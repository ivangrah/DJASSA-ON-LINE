{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Article (ProductResource)",
  "type": "object",
  "required": [
    "id",
    "titre",
    "prix",
    "condition",
    "mode_transaction",
    "statut",
    "stock",
    "categorie"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "titre": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "prix": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
    },
    "prix_flash": {
      "type": [
        "string",
        "null"
      ]
    },
    "prix_actuel": {
      "type": [
        "string",
        "number"
      ]
    },
    "prix_negociable": {
      "type": "boolean"
    },
    "condition": {
      "enum": [
        "neuf",
        "comme_neuf",
        "bon_etat",
        "usage"
      ]
    },
    "mode_transaction": {
      "enum": [
        "vente",
        "troc",
        "mixte"
      ]
    },
    "est_trocable": {
      "type": "boolean"
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "categorie": {
      "type": "string"
    },
    "specs": {
      "type": "object"
    },
    "images": {
      "type": "array"
    },
    "image_principale": {
      "type": [
        "string",
        "null"
      ]
    },
    "ville": {
      "type": "string"
    },
    "quartier": {
      "type": [
        "string",
        "null"
      ]
    },
    "statut": {
      "enum": [
        "draft",
        "published",
        "reserved",
        "sold",
        "archived"
      ]
    },
    "vente_flash": {
      "type": "boolean"
    },
    "flash_fin_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "vues": {
      "type": "integer",
      "minimum": 0
    },
    "favoris": {
      "type": "integer",
      "minimum": 0
    },
    "est_neuf_boutique": {
      "type": "boolean"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
